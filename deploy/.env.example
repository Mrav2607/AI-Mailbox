# Production template. Copy to deploy/.env, generate every required secret,
# fill in the Google OAuth settings, then run from the repo root:
#   cp deploy/.env.example deploy/.env
#   openssl rand -hex 32                     # API_SECRET
#   openssl rand -hex 32                     # POSTGRES_PASSWORD / REDIS_PASSWORD
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# The stack intentionally refuses to start while the placeholder secrets remain.
# For the zero-config local demo-login flow, use deploy/local.env.example instead.

# --- Postgres ---
# These are read by the db container AND make up DATABASE_URL below -- keep them
# in sync. Avoid special characters here, or URL-encode them in DATABASE_URL
# (e.g. "#" -> "%23", "@" -> "%40").
POSTGRES_USER=mailbox
POSTGRES_PASSWORD=change_me
POSTGRES_DB=cortexmail

# --- Edge / TLS ---
# Only used by the production overlay (deploy/compose.prod.yml). Caddy gets a
# Let's Encrypt cert for APP_DOMAIN, so this must be a real domain whose DNS
# already points at this box (A *and* AAAA -- a stale AAAA silently breaks the
# ACME challenge), with inbound 80 and 443 open.
APP_DOMAIN=mail.example.com
# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=you@example.com

# --- App ---
# Production disables the passwordless demo login and validates the required
# JWT, token-encryption, and Google OAuth settings at startup.
APP_ENV=production
# Signs session tokens (HS256 JWT). Replace before starting the stack.
API_SECRET=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MINUTES=10080  # 7 days
# Encrypts provider OAuth tokens at rest (Fernet, urlsafe base64 32 bytes).
# Production requires a dedicated key. Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Hosts are the compose service names. DATABASE_URL uses the psycopg v3 driver,
# so the scheme MUST be postgresql+psycopg:// (plain postgresql:// looks for
# psycopg2, which isn't installed).
DATABASE_URL=postgresql+psycopg://mailbox:change_me@db:5432/cortexmail
# Use the same generated value in both fields. Redis refuses to start with the
# placeholder password.
REDIS_PASSWORD=change_me
REDIS_URL=redis://:change_me@redis:6379/0

# Browser origins allowed to call the API (CORS). Not exercised in the default
# single-origin setup (nginx proxies /api), but set for anyone hitting :8000
# directly. Never use "*" with credentialed requests.
CORS_ORIGINS=https://mail.example.com

# --- Email classifier ---
# Canonical GLOBAL values: auto | heuristic | llm.
#   auto      = an opted-in user's own key first, else the local encoder, else
#               the keyword heuristic. There is no operator-paid LLM step --
#               GEMINI_API_KEY below does not feed classification at all.
#   heuristic = keyword rules only, no deps or model, no LLM calls at all.
#   llm       = same LLM path as auto, minus the local-encoder step.
#
# "auto" and "llm" only reach an LLM if a user opted in their own BYOK key.
# With nobody opted in, both end at the heuristic without a single call, and
# a credential the router resolves to "off" never reaches one either.
#
# "local" and "gemini" are DEPRECATED aliases (for "auto" and "llm"): still
# accepted, mapped at startup with a warning, and scheduled for removal. Move
# off them when you touch this file.
#
# BYOK ACTIVATION WARNING: under "heuristic", keyword rules return before
# routing is even read, so a user's saved key and classification opt-in are
# never used. Flipping to "auto" or "llm" activates every stored credential
# with "use my key to sort mail" already checked -- including ones set via the
# API on a deployment that has only ever run "heuristic", since the UI hides
# that checkbox but the backend doesn't block it. Once active: their mail
# content is sent to their provider, their key gets billed, and a failed call
# leaves the message unclassified rather than heuristically labeled (opted-in
# users who also enabled the local-fallback setting get the encoder instead).
# If you're flipping a live deployment, know who has opted in before you do.
#
# A per-run backend (the console's backfill picker) overrides this verbatim --
# and picking "local encoder" there never spends anyone's key, even when the
# encoder can't serve.
CLASSIFIER_BACKEND=auto

# --- LLM / Google OAuth ---
# GEMINI_API_KEY / GEMINI_MODEL serve action extraction and reply drafting
# only (see "Action extraction" below) -- classification never reads them.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The SPA handles the callback, so use its public HTTPS origin, not the API.
# Register the same URI in the Google Cloud console OAuth client.
GOOGLE_REDIRECT_URI=https://mail.example.com/auth/google/callback

# --- Microsoft OAuth (optional -- Outlook stays hidden until all three of
# id/secret/redirect are set; safe to leave blank) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Same SPA-origin rule as Google; register it on the Entra app registration.
MICROSOFT_REDIRECT_URI=https://mail.example.com/auth/microsoft/callback
# Entra tenant: "common" = personal + work/school accounts.
MICROSOFT_TENANT=common
# Initial lookback window (days) for a new Outlook account's first sync.
OUTLOOK_BACKFILL_DAYS=90

# --- Action extraction (opt-in, off by default) ---
# Second-stage Gemini call that pulls concrete obligations (tasks, due dates,
# amounts) out of already-classified action mail for the Agenda view. Needs
# GEMINI_API_KEY above -- without it, enabling this flag does nothing.
ACTION_EXTRACTION_ENABLED=false
# When true (default), users who haven't saved their own LLM credential fall
# back to GEMINI_API_KEY above for extraction -- today's behavior, unchanged.
# Set false for BYOK-only: extraction only runs for users with a saved
# credential, and the operator's key is never used for their mail.
ACTION_EXTRACTION_SERVER_FALLBACK=true
# Lets users point extraction at a custom (self-hosted or third-party)
# OpenAI-compatible endpoint instead of a preset provider. Off by default:
# this is an SSRF surface, since the server makes an outbound POST to a
# URL the user supplies. When on, custom endpoints are restricted to
# https and globally-routable addresses only.
LLM_CUSTOM_ENDPOINTS_ENABLED=false
# Second, louder opt-in on top of the flag above. Also allows plain http
# and private/LAN addresses for custom endpoints (e.g. a local Ollama
# instance). Turning this on means ANY authenticated user can make this
# server reach private addresses on your network -- only enable it for
# deployments where every user is trusted.
LLM_PRIVATE_ENDPOINTS_ENABLED=false
